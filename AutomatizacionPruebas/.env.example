ADSEF_BASE_URL=http://192.168.10.68/adsefdigitalss/
# Completar localmente en .env. No guardar credenciales en los tests.
ADSEF_USERNAME=
ADSEF_PASSWORD=
# Tras observar un login real, indicar URL absoluta y selector de un elemento
# exclusivo de la pantalla autenticada. Ambos son obligatorios en test:auth.
ADSEF_AUTHENTICATED_URL=
ADSEF_AUTHENTICATED_SELECTOR=
# Usuario existente del módulo de búsqueda. No necesariamente coincide con la cuenta operadora.
ADSEF_SEARCH_EMAIL=
# Usuario ID esperado en una fila del resultado (el correo puede tener varias coincidencias).
ADSEF_SEARCH_USER_ID=
# Nueve dígitos, guardados como texto. Dato local: no incluir en el feature.
ADSEF_SEARCH_SSN=
