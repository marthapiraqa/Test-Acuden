{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["playwright*.config.ts", "pages/**/*.ts", "fixtures/**/*.ts", "tests/**/*.ts", "steps/**/*.ts"]
}
